{
  "schema": 1,
  "policyId": "github-native-secret-observation-v1",
  "activation": "protected-main",
  "repository": "closure-labs/xo-nixpkg",
  "requiredSettings": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled"
  },
  "maxObservationAgeSeconds": 300,
  "maxCollectionSeconds": 120,
  "maxAlertPagesPerPass": 20,
  "alertsPerPage": 100,
  "matchingPasses": 2,
  "maxOpenAlerts": 0,
  "assurance": "posture-and-alert-observation-only"
}
